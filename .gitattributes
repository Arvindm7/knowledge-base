# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly treat documentation and config files as text with LF
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.webp binary
*.ico binary
*.pdf binary
